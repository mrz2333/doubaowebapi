# doubaowebapi 环境变量配置
# 复制此文件为 .env 并按需修改
# 注：环境变量前缀保留 DOLA_ 以兼容旧版部署，实际服务为 Dola

# 服务端口
DOUBAO_PORT=8458

# 监听地址 (Docker 部署用 0.0.0.0)
DOUBAO_HOST=127.0.0.1

# API 密钥 (用于保护 /v1/* 端点，留空则不鉴权)
DOLA_API_KEY=

# Session 文件路径
DOLA_SESSION_FILE=.dola_session.json

# 每分钟请求限制
DOLA_RPM_LIMIT=50

# 请求超时 (秒)
DOLA_TIMEOUT=180

# Session 保活间隔 (秒，默认 2 小时)
DOLA_KEEPALIVE_INTERVAL=7200

# 默认 Bot ID (7339470689562525703 = 扩展版/Expert)
DOLA_BOT_ID=7339470689562525703

# msToken (可选，留空最安全；假值会触发风控)
DOLA_MS_TOKEN=
